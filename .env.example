# Hardware target: GPU or CPU (case-insensitive). Default: CPU.
# GPU mode: nvidia.com/gpu resources, runtimeClassName, NVIDIA_VISIBLE_DEVICES, DCGM exporter.
# CPU mode: cpu/memory resources only, no NVIDIA-specific fields.
TARGET=GPU

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ministral-3:8b-instruct-2512-q4_K_M
EVAL_ENABLED=true
EVAL_JUDGE_TEMPERATURE=0.1
EVAL_JUDGE_TOP_P=0.95
EVAL_REFERENCES_PATH=refs/production_references.json

RAG_ENABLED=true
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_COLLECTION=documents

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=llmops-chat
OTEL_DEPLOYMENT_ENVIRONMENT=dev
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none

SINGLE_NODE_CPU=14
SINGLE_NODE_MEMORY=12G

SINGLE_NODE_CPU_RESERVATION=12
SINGLE_NODE_MEMORY_RESERVATION=10G

#Experiments variables

N_RUNS_RQ3_TEST=20

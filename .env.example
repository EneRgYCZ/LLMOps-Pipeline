# Model served by Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ministral-3:8b-instruct-2512-q4_K_M

# OpenTelemetry — set only OTEL_EXPORTER_OTLP_ENDPOINT; the per-signal
# endpoints (metrics/traces) are derived automatically if left unset.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional overrides (uncomment to customise)
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Service identity visible in Grafana and trace backends
OTEL_SERVICE_NAME=llmops-chat
OTEL_DEPLOYMENT_ENVIRONMENT=dev
